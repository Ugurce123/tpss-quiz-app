{
  "version": 2,
  "builds": [
    {
      "src": "package.json",
      "use": "@vercel/static-build",
      "config": {
        "distDir": "build"
      }
    }
  ],
  "routes": [
    {
      "src": "/(.*)",
      "dest": "/index.html"
    }
  ],
  "env": {
    "REACT_APP_API_URL": "https://tpss-quiz-app.vercel.app",
    "CI": "false",
    "GENERATE_SOURCEMAP": "false",
    "ESLINT_NO_DEV_ERRORS": "true"
  }
}